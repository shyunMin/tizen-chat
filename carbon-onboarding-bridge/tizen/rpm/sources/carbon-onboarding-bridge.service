[Unit]
Description=Carbon Onboarding Bridge
After=network.target

[Service]
Type=simple
User=owner
Group=users
Environment=HOME=/opt/usr/home/owner
Environment=XDG_RUNTIME_DIR=/run/user/5001
ExecStart=/usr/bin/carbon-onboarding-bridge
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
